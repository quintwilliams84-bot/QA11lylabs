{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA11y agent evidence return v1",
  "$comment": "Sidecar provenance data only. Producer names are not reader routing identities. Validity does not authenticate evidence, establish receipt, grant permission or prove outcomes. Do not include secrets or private client data. q is next_owner only for an actually required user decision. The stdlib parser additionally enforces UTF-8, a 65536-byte input limit, duplicate-key rejection, regular-file/no-final-symlink checks and a lexical integer schema_version (1, not 1.0). Relative evidence_ref paths resolve against the containing return publication commit; source.commit remains the exact reviewed code revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "producer",
    "source",
    "changed_paths",
    "scope_summary",
    "checks",
    "blockers",
    "next_owner",
    "next_action",
    "authorization"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "not": {
        "pattern": "[^a-z0-9-]"
      }
    },
    "producer": {
      "enum": [
        "arch",
        "codex",
        "muse",
        "antigravity",
        "hermes",
        "perplexity"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit"
      ],
      "properties": {
        "repository": {
          "enum": [
            "quintwilliams84-bot/QA11lylabs",
            "quintwilliams84-bot/OpenclawOps",
            "quintwilliams84-bot/qa11ylabs-website"
          ]
        },
        "branch": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_-]{0,100}$",
          "not": {
            "pattern": "[^a-z0-9/_-]"
          }
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "not": {
            "pattern": "[^a-f0-9]"
          }
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "scope_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "not": {
        "pattern": "[^ -~]"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result",
          "evidence_ref",
          "summary"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "not": {
              "pattern": "[^ -~]"
            }
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "UNKNOWN",
              "NOT RUN"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "not": {
              "pattern": "[^ -~]"
            },
            "anyOf": [
              {
                "const": "NOT AVAILABLE"
              },
              {
                "$ref": "#/$defs/path"
              },
              {
                "pattern": "^https://github\\.com/quintwilliams84-bot/(?:QA11lylabs|OpenclawOps|qa11ylabs-website)/commit/[a-f0-9]{40}$"
              },
              {
                "pattern": "^https://github\\.com/quintwilliams84-bot/(?:QA11lylabs|OpenclawOps|qa11ylabs-website)/blob/[a-f0-9]{40}/(?=.{1,240}$)(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*$"
              }
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320,
            "not": {
              "pattern": "[^ -~]"
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "not": {
          "pattern": "[^ -~]"
        }
      }
    },
    "next_owner": {
      "enum": [
        "arch",
        "codex",
        "muse",
        "antigravity",
        "hermes",
        "perplexity",
        "q"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "not": {
        "pattern": "[^ -~]"
      }
    },
    "authorization": {
      "const": "none"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "not": {
        "pattern": "[^ -~]"
      },
      "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*$"
    }
  }
}
