#!/usr/bin/env bash
# systemd-run stub (Rev 6, transient SERVICE mode): starts the
# command in the background, records unit -> pid, returns at once.
set -u
STATE="${STUB_SYSTEMD_STATE:?}"
mkdir -p "$STATE/units"
UNIT=""; SETENVS=(); CMD=()
while [ $# -gt 0 ]; do
  case "$1" in
    --unit) UNIT="$2"; shift 2;;
    --unit=*) UNIT="${1#--unit=}"; shift;;
    -p|--property) shift 2;;
    --property=*) shift;;
    --setenv) SETENVS+=("$2"); shift 2;;
    --setenv=*) SETENVS+=("${1#--setenv=}"); shift;;
    --) shift; CMD=("$@"); break;;
    -*) shift;;
    *) CMD=("$@"); break;;
  esac
done
if [ "${STUB_SYSTEMD_RUN_FAIL:-}" = 1 ]; then echo "stub systemd-run: launch failed" >&2; exit 1; fi
UNIT="${UNIT%.service}"
[ -n "$UNIT" ] || { echo "stub systemd-run: no unit" >&2; exit 1; }
env "${SETENVS[@]}" "${CMD[@]}" &
echo $! > "$STATE/units/$UNIT.pid"
exit 0
