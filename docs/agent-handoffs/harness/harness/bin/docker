#!/usr/bin/env bash
# Docker CLI shim (Rev 7): placed first on PATH for the harness
# process tree only (see run-confined.sh). Delegates everything to
# the real docker binary ($STAGE_REAL_DOCKER, default
# /usr/bin/docker) and logs every call to $STAGE_ROOT/docker-calls.log.
#
# Ownership capture uses the daemon client's CIDFILE protocol,
# never output scraping. Rev 7 completes the protocol:
# - A caller-supplied --cidfile is honored AND read back, exactly
#   like an injected one (Rev 6 skipped caller cidfiles).
# - BEFORE delegating, the shim appends the effective cidfile
#   path to $STAGE_ROOT/cidfiles.txt. If the shim or the attached
#   run is interrupted or killed mid-flight, that record survives
#   and the supervisor harvests the container ID from the named
#   cidfile during cleanup - ownership is captured DURING the
#   run, not only after it.
# - After a completed call, the ID is also appended directly to
#   $STAGE_ROOT/owned-containers.txt (fast path).
#
# Stated limitation, unchanged: if the runner talks to the Docker
# API directly instead of the CLI, this shim sees nothing,
# captures nothing, and cleanup reports UNKNOWN rather than PASS.
set -uo pipefail
REAL="${STAGE_REAL_DOCKER:-/usr/bin/docker}"
LOG="${STAGE_ROOT:-/tmp}/docker-calls.log"
echo "docker $*" >> "$LOG" 2>/dev/null || true
SUB="${1:-}"
case "$SUB" in
  create|run)
    CIDFILE=""; PREV=""
    for a in "$@"; do
      if [ "$PREV" = "--cidfile" ]; then CIDFILE="$a"; fi
      case "$a" in --cidfile=*) CIDFILE="${a#--cidfile=}";; esac
      PREV="$a"
    done
    if [ -z "$CIDFILE" ]; then
      CIDFILE="${STAGE_ROOT}/cid-$$.txt"
      set -- "$1" --cidfile "$CIDFILE" "${@:2}"
    fi
    # Record the cidfile path BEFORE the call: interruption-proof.
    echo "$CIDFILE" >> "${STAGE_ROOT}/cidfiles.txt" 2>/dev/null || true
    "$REAL" "$@"
    RC=$?
    if [ -s "$CIDFILE" ]; then
      ID="$(tr -d '[:space:]' < "$CIDFILE")"
      case "$ID" in *[!0-9a-f]*|"") : ;;
        *) [ "${#ID}" = 64 ] && echo "$ID" >> "${STAGE_ROOT}/owned-containers.txt" 2>/dev/null || true;;
      esac
    fi
    exit "$RC"
    ;;
  *)
    exec "$REAL" "$@"
    ;;
esac
